load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":bazel_integration_test.bzl", "bazel_integration_test")
load(":bazel_versions.bzl", "BAZEL_VERSIONS")

sh_binary(
    name = "setup",
    srcs = ["setup.bash"],
    visibility = ["//test:__subpackages__"],
)

[
    bazel_integration_test(
        name = "examples_bazel_" + bazel["version"],
        bazel_binary = bazel_binaries.label(
            bazel_binaries.versions.current if bazel["version"] == "pinned" else bazel["version"],
        ),
        env = {"BAZEL_TEST_OPTS": " ".join(bazel["flags"])},
        runner = "examples.bash",
    )
    for bazel in BAZEL_VERSIONS
]
