module(
    name = "rules_multitransition",
    version = "0.0.0",
    bazel_compatibility = [">=7.1.0"],
)

bazel_dep(
    name = "bazel_skylib",
    version = "1.7.1",
)
bazel_dep(
    name = "rules_cc",
    version = "0.0.10",
)
bazel_dep(
    name = "platforms",
    version = "0.0.10",
)

multitransition_config = use_extension("//:extensions.bzl", "multitransition_config")
use_repo(multitransition_config, "multitransition_config")

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.2.1.1",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_bazel_integration_test",
    version = "0.37.1",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_shell",
    version = "0.8.0",
    dev_dependency = True,
)
bazel_dep(
    name = "stardoc",
    version = "0.8.1",
    dev_dependency = True,
)

bazel_binaries = use_extension(
    "@rules_bazel_integration_test//:extensions.bzl",
    "bazel_binaries",
    dev_dependency = True,
)
bazel_binaries.download(version_file = "//:.bazelversion")
bazel_binaries.download(version = "7.1.0")
bazel_binaries.download(version = "8.x")
bazel_binaries.download(version = "9.x")
use_repo(
    bazel_binaries,
    "bazel_binaries",
    "bazel_binaries_bazelisk",
    "build_bazel_bazel_.bazelversion",
    "build_bazel_bazel_7_1_0",
    "build_bazel_bazel_8_x",
    "build_bazel_bazel_9_x",
)

git_archive = use_repo_rule("//test:git_archive.bzl", "git_archive")

git_archive(
    name = "git_archive",
    dev_dependency = True,
)

local_config_bazel = use_repo_rule("//test:local_config_bazel.bzl", "local_config_bazel")

local_config_bazel(
    name = "local_config_bazel",
    dev_dependency = True,
)
