module(
    name = "rules_multitransition",
    version = "0.0.0",
    bazel_compatibility = [">=7.1.0"],
)

bazel_dep(
    name = "bazel_skylib",
    version = "1.8.2",
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.17",
)
bazel_dep(
    name = "platforms",
    version = "1.0.0",
)

multitransition_config = use_extension("//:extensions.bzl", "multitransition_config")
use_repo(multitransition_config, "multitransition_config")

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.2.1.1",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_shell",
    version = "0.8.0",
    dev_dependency = True,
)
bazel_dep(
    name = "stardoc",
    version = "0.8.1",
    dev_dependency = True,
)
