load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

# When False, only the underlying '<name>' test of each 'multitransition.test'
# is compatible. When True, '<name>' is skipped and the variants run.
bool_flag(
    name = "multitransition_test",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "multitransition_test_enabled",
    flag_values = {
        ":multitransition_test": "True",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "multitransition_test_disabled",
    flag_values = {
        ":multitransition_test": "False",
    },
    visibility = ["//visibility:public"],
)

# When False, the variants of each 'multitransition.binary' are incompatible,
# leaving only the underlying '<name>' binary. '<name>' is always compatible.
bool_flag(
    name = "multitransition_binary",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "multitransition_binary_enabled",
    flag_values = {
        ":multitransition_binary": "True",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "multitransition_binary_disabled",
    flag_values = {
        ":multitransition_binary": "False",
    },
    visibility = ["//visibility:public"],
)
