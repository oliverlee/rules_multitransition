load("@cortex_m//rules:transitions.bzl", "transition_config_test")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_multitransition//:defs.bzl", "multitransition")
load("//test:compile_flags_test.bzl", "compile_flags_test")

# create a base cc_test target
cc_test(
    name = "target_platform_base",
    srcs = ["info.cpp"],
    tags = ["manual"],
)

# transition_config_test is used to enable semihosting -- which enables printing
# for the cortex-m3 toolchain
#
# output can be observed with
# bazel test --test_output=all //...
multitransition.test(
    transition_config_test,
    name = "target_platform_test",
    src = ":target_platform_base",
    transitions = [
        multitransition.transition(
            name = "host",
            platform = "@platforms//host",
        ),
        multitransition.transition(
            name = "cortex-m3",
            platform = "@cortex_m//platform:lm3s6965evb",
        ),
    ],
)

[
    compile_flags_test(
        name = "mcpu_{}_test".format(variant),
        expect = expect,
        flag = "-mcpu=cortex-m3",
        target = ":target_platform_test.{}".format(variant),
    )
    for variant, expect in [
        ("host", "absent"),
        ("cortex-m3", "present"),
    ]
]
