load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_multitransition//:defs.bzl", "multitransition")
load("@rules_multitransition_test//:compile_flags_test.bzl", "compile_flags_test")

multitransition.test(
    cc_test,
    name = "compilation_mode_test",
    srcs = ["dummy.cpp"],
    transitions = [
        multitransition.transition(
            name = "dbg",
            compilation_mode = "dbg",
        ),
        multitransition.transition(
            name = "opt",
            compilation_mode = "opt",
        ),
    ],
)

[
    compile_flags_test(
        name = "uses_{}_compile_flags_test".format(flavor),
        expect = "present",
        flag = flag,
        target = ":compilation_mode_test.{}".format(flavor),
    )
    for flavor, flag in [
        ("dbg", "-g"),
        ("opt", "-O2"),
    ]
]
