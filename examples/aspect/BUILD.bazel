load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_multitransition//:multitransition.bzl", "multitransition")

SOURCE_FILES = multitransition.transition(
    name = "source_files",
    aspect = multitransition.aspect(
        aspect = "//test:transitive_source_files.bzl%transitive_source_files",
        output_group = "transitive_source_files",
    ),
)

# bazel build //aspect:lib.source_files
multitransition.target(
    cc_library,
    name = "lib",
    hdrs = ["lib.hpp"],
    transitions = [SOURCE_FILES],
)

multitransition.target(
    cc_test,
    name = "lib_test",
    testonly = True,
    srcs = ["lib_test.cpp"],
    transitions = [SOURCE_FILES],
    deps = [":lib"],
)

# an existing target, e.g. from another package or repo, through 'alias'
multitransition.target(
    alias,
    name = "lib_alias",
    actual = ":lib",
    transitions = [SOURCE_FILES],
)

[
    diff_test(
        name = "{}_source_files_test".format(target),
        file1 = ":{}.source_files".format(target),
        file2 = "{}.source_files.expected.txt".format(expected),
    )
    for target, expected in [
        ("lib", "lib"),
        ("lib_test", "lib_test"),
        ("lib_alias", "lib"),
    ]
]
