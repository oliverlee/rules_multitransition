load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_multitransition//:defs.bzl", "multitransition")

cc_library(
    name = "lib",
    hdrs = ["lib.hpp"],
)

cc_test(
    name = "lib_test",
    srcs = ["lib_test.cpp"],
    deps = [":lib"],
)

SOURCE_FILES = multitransition.transition(
    name = "source_files",
    aspect = multitransition.aspect(
        aspect = "@rules_multitransition_test//:transitive_source_files.bzl%transitive_source_files",
        output_group = "transitive_source_files",
    ),
)

# bazel build //:lib_transitioned.source_files
multitransition.target(
    name = "lib_transitioned",
    src = ":lib",
    transitions = [SOURCE_FILES],
)

multitransition.target(
    name = "lib_test_transitioned",
    testonly = True,
    src = ":lib_test",
    transitions = [SOURCE_FILES],
)

[
    diff_test(
        name = "{}_source_files_test".format(target),
        file1 = ":{}_transitioned.source_files".format(target),
        file2 = "{}.source_files.expected.txt".format(target),
    )
    for target in [
        "lib",
        "lib_test",
    ]
]
