bazel_dep(
    name = "bazel_skylib",
    version = "1.8.2",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.14",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_multitransition",
    dev_dependency = True,
)
local_path_override(
    module_name = "rules_multitransition",
    path = "../../",
)

bazel_dep(
    name = "rules_multitransition_test",
    dev_dependency = True,
)
local_path_override(
    module_name = "rules_multitransition_test",
    path = "../../test",
)

multitransition_config = use_extension(
    "@rules_multitransition//:extensions.bzl",
    "multitransition_config",
    dev_dependency = True,
)
multitransition_config.aspect(
    aspect = "@rules_multitransition_test//:transitive_source_files.bzl%transitive_source_files",
)
