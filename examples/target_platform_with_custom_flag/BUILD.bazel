load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_multitransition//:defs.bzl", "multitransition")
load("@rules_multitransition_test//:compile_flags_test.bzl", "compile_flags_test")

# '@cortex_m//config:semihosting' is declared with the 'multitransition_config'
# module extension in MODULE.bazel
multitransition.test(
    cc_test,
    name = "target_platform_test",
    srcs = ["info.cpp"],
    transitions = [
        multitransition.transition(
            name = "host",
            platform = "@platforms//host",
        ),
        multitransition.transition(
            name = "cortex-m3",
            flags = {
                "@cortex_m//config:semihosting": True,
            },
            platform = "@cortex_m//platform:lm3s6965evb",
        ),
    ],
)

[
    compile_flags_test(
        name = "mcpu_{}_test".format(variant),
        expect = expect,
        flag = "-mcpu=cortex-m3",
        target = ":target_platform_test.{}".format(variant),
    )
    for variant, expect in [
        ("host", "absent"),
        ("cortex-m3", "present"),
    ]
]
