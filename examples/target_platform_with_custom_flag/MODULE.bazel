bazel_dep(
    name = "cortex_m",
    dev_dependency = True,
)
bazel_dep(
    name = "platforms",
    version = "1.0.0",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.17",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_multitransition",
    dev_dependency = True,
)
bazel_dep(
    name = "toolchains_arm_gnu",
    dev_dependency = True,
)

[
    archive_override(
        module_name = "cortex_m",
        integrity = "sha256-RCBK+5PFoY950AbzLU7AmyqE8rVOmGN9Pkxw2YWXXhk=",
        patch_cmds = [
            # `xcode_config` is not a builtin in Bazel 9
            "sed -i.orig '/^xcode_config(/d' BUILD.bazel",
            # Bazel 9 provides `runfiles.bash` at the legacy path only via
            # root symlinks in `default_runfiles`, not in `files`
            "perl -0pi -e 's/\\n\\s*transitive_files = ctx.attr._runfiles.files,\\n\\s*\\)/\\n            ).merge(ctx.attr._runfiles[DefaultInfo].default_runfiles)/' rules/qemu_runner.bzl",
        ],
        strip_prefix = "cortex_m-{}".format(commit),
        urls = [
            "https://github.com/oliverlee/cortex_m/archive/{}.tar.gz".format(commit),
        ],
    )
    for commit in ["37981beef61a75c26672e9330c1cf6da875af7bc"]
]

[
    archive_override(
        module_name = "toolchains_arm_gnu",
        integrity = "sha256-QKl/PAnjE4O4IEKIwImJIT3ihjtWHPTY9h5FBg7yKFQ=",
        # `@local_config_platform` is removed in Bazel 9
        # https://github.com/hexdae/toolchains_arm_gnu/pull/99
        patch_cmds = ["sed -i.orig 's|@local_config_platform//:constraints.bzl|@platforms//host:constraints.bzl|' toolchain/templates/toolchain.bazel"],
        strip_prefix = "toolchains_arm_gnu-{}".format(commit),
        urls = [
            "https://github.com/hexdae/toolchains_arm_gnu/archive/{}.tar.gz".format(commit),
        ],
    )
    for commit in ["6895733b87d3a75a40056b12c3d6628bc6945011"]
]

local_path_override(
    module_name = "rules_multitransition",
    path = "../../",
)

bazel_dep(
    name = "rules_multitransition_test",
    dev_dependency = True,
)
local_path_override(
    module_name = "rules_multitransition_test",
    path = "../../test",
)

multitransition_config = use_extension(
    "@rules_multitransition//:extensions.bzl",
    "multitransition_config",
    dev_dependency = True,
)
multitransition_config.extend(
    flags = ["@cortex_m//config:semihosting"],
)
