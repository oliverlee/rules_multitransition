bazel_dep(
    name = "rules_cc",
    version = "0.2.14",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_shell",
    version = "0.6.1",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_multitransition",
    dev_dependency = True,
)
local_path_override(
    module_name = "rules_multitransition",
    path = "../../",
)
bazel_dep(
    name = "rules_multitransition_test",
    dev_dependency = True,
)
local_path_override(
    module_name = "rules_multitransition_test",
    path = "../../test",
)

local_config = use_extension(
    "@rules_multitransition_test//extension:local_config.bzl",
    "local_config",
    dev_dependency = True,
)
use_repo(
    local_config,
    "local_workspace_directory",
)
