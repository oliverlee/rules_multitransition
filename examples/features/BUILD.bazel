load("@rules_cc//cc:defs.bzl", "cc_test")
load(
    "@rules_multitransition//:defs.bzl",
    "multitransition_test",
    "transition_config",
)
load("@rules_multitransition_test//:compile_flags_test.bzl", "compile_flags_test")

# 'treat_warnings_as_errors' adds '-Werror' to compile actions with the
# default rules_cc toolchain.
multitransition_test(
    cc_test,
    name = "features_test",
    srcs = ["dummy.cpp"],
    transitions = [
        transition_config(
            name = "enabled",
            features = ["treat_warnings_as_errors"],
        ),
        # A negative feature overrides a positive one, so the disable also
        # applies when the feature is enabled earlier, e.g. on the command
        # line.
        transition_config(
            name = "disabled",
            features = [
                "treat_warnings_as_errors",
                "-treat_warnings_as_errors",
            ],
        ),
    ],
)

[
    compile_flags_test(
        name = "werror_{}_test".format(variant),
        expect = expect,
        flag = "-Werror",
        target = ":features_test.{}".format(variant),
    )
    for variant, expect in [
        ("enabled", "present"),
        ("disabled", "absent"),
    ]
]
