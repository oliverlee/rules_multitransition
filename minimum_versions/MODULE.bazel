# Tests the examples that don't need other toolchains with the minimum
# versions of Bazel ('.bazeliskrc') and of the dependencies of
# 'rules_multitransition', which match its MODULE.bazel.
bazel_dep(
    name = "bazel_skylib",
    version = "1.7.1",
    dev_dependency = True,
)
bazel_dep(
    name = "platforms",
    version = "0.0.10",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_cc",
    version = "0.0.10",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_multitransition",
    dev_dependency = True,
)
local_path_override(
    module_name = "rules_multitransition",
    path = "..",
)
