"""
Module extension that declares which options transitions may set and which
aspects 'multitransition.target' may apply.

```bzl
# MODULE.bazel
multitransition_config = use_extension(
    "@rules_multitransition//:extensions.bzl",
    "multitransition_config",
    dev_dependency = True,
)
multitransition_config.extend(
    aspects = ["@rules_clang_tidy//:aspects.bzl%check"],
    command_line_options = ["conlyopt"],
    flags = ["@cortex_m//config:semihosting"],
)
```

Tags from every module in the dependency graph are combined into a single
transition. Use `dev_dependency = True` unless other modules rely on the
declarations, e.g. through a macro wrapping `multitransition.test`; dev
tags are ignored when the module is not the root.

rules_multitransition's own usage is not a dev dependency: it provides the
`@multitransition_config` repo that `defs.bzl` loads for every user.
"""

load("//private:default_options.bzl", "DEFAULT_OPTIONS")

visibility("public")

_extend = tag_class(
    attrs = {
        "aspects": attr.label_list(
            # Labels, so they're resolved in the declaring module. '%' is valid
            # in a target name, so '<bzl file>%<name>' parses as a single label.
            doc = "Aspects 'multitransition.target' may apply, as '<bzl file>%<name>', " +
                  "e.g. '@rules_clang_tidy//:aspects.bzl%check'.",
        ),
        "command_line_options": attr.string_list(
            doc = "Native options 'multitransition.transition' may set, without " +
                  "leading dashes, e.g. 'conlyopt'.",
        ),
        "flags": attr.label_list(
            doc = "Starlark build settings 'multitransition.transition' may set, " +
                  "e.g. a 'bool_flag'.",
        ),
    },
    doc = "Extends the options transitions may set and the aspects 'multitransition.target' may apply.",
)

_OPTIONS_BZL = """\
\"\"\"
Generated by the 'multitransition_config' module extension.
\"\"\"

OPTIONS = {options}
"""

_ASPECTS_BZL = """\
\"\"\"
Generated by the 'multitransition_config' module extension.
\"\"\"

load("{rule_bzl}", "multitransition_target_rule_for_aspect")
{loads}
{rules}
RULES = {{
{entries}}}
"""

_ASPECT_LOAD = """load("{bzl_file}", _aspect_{index} = "{name}")\n"""

_ASPECT_RULE = """multitransition_target_{index} = multitransition_target_rule_for_aspect(_aspect_{index})\n"""

_ASPECT_ENTRY = """    "{aspect}": multitransition_target_{index},\n"""

def _options_repo_impl(rctx):
    rctx.file("BUILD.bazel", "")
    rctx.file(
        "defs.bzl",
        content = _OPTIONS_BZL.format(options = repr(rctx.attr.options)),
    )

    loads = ""
    rules = ""
    entries = ""
    for index, aspect in enumerate(rctx.attr.aspects):
        bzl_file, name = aspect.split("%")
        loads += _ASPECT_LOAD.format(
            bzl_file = bzl_file,
            index = index,
            name = name,
        )
        rules += _ASPECT_RULE.format(
            index = index,
        )
        entries += _ASPECT_ENTRY.format(
            aspect = aspect,
            index = index,
        )

    rctx.file(
        "aspects.bzl",
        content = _ASPECTS_BZL.format(
            rule_bzl = rctx.attr.rule_bzl,
            loads = loads,
            rules = rules,
            entries = entries,
        ),
    )

_options_repo = repository_rule(
    implementation = _options_repo_impl,
    attrs = {
        "aspects": attr.string_list(
            doc = "Canonical `<bzl file>%<name>` of each aspect.",
        ),
        "options": attr.string_list(mandatory = True),
        "rule_bzl": attr.string(
            mandatory = True,
            doc = "Canonical label of the `.bzl` exporting the rule factory.",
        ),
    },
)

def _impl(mctx):
    extra = {}
    aspects = {}
    for mod in mctx.modules:
        for tag in mod.tags.extend:
            # canonical labels, valid when loaded from any repo
            for aspect in tag.aspects:
                aspects[str(aspect)] = None
            for flag in tag.flags:
                extra[str(flag)] = None
            for name in tag.command_line_options:
                extra["//command_line_option:{}".format(name)] = None

    _options_repo(
        name = "multitransition_config",
        aspects = sorted(aspects),
        rule_bzl = str(Label("//:multitransition_target_rule_for_aspect.bzl")),
        options = DEFAULT_OPTIONS + sorted([
            option
            for option in extra
            if option not in DEFAULT_OPTIONS
        ]),
    )

    return mctx.extension_metadata(reproducible = True)

multitransition_config = module_extension(
    implementation = _impl,
    tag_classes = {
        "extend": _extend,
    },
)
